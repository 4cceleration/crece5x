# Base de datos: SQLite local. En Vercel: libsql://<db>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Auth
BETTER_AUTH_SECRET=cambia-esto-por-32-caracteres-aleatorios
BETTER_AUTH_URL=http://localhost:3000

# IA (vacío = analista simulado)
#   groq/openai/gpt-oss-120b  → Groq directo con GROQ_API_KEY
#   proveedor/modelo          → Vercel AI Gateway (AI_GATEWAY_API_KEY u OIDC en Vercel)
AI_MODEL=
GROQ_API_KEY=
AI_GATEWAY_API_KEY=

# Archivos (vacío = disco local en .data/uploads)
BLOB_READ_WRITE_TOKEN=

# Correo (vacío = archivos en .data/emails)
RESEND_API_KEY=
MAIL_FROM=CRECE <no-responder@tu-dominio.com>

# Cron de recordatorios
CRON_SECRET=cambia-esto

# Google (opcional). URI de redirección autorizada: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
